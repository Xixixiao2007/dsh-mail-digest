    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.mjs",
    "digest.mjs",
    "summary.mjs",
    "smtp.mjs",
    "imap.mjs",
    "qa.mjs",
    "reply.mjs",
    "pending.mjs",
    "config.mjs",
    "settings.mjs",
    "cordis.patch.yml",
    "README.md",
    "DEVELOPMENT.md",
    "AGENTS.md",
    "AGENTS.dsh-mail-digest.md",
    "test-installer.ps1",
    "tools/AgentRules.ps1"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "email",
    "digest",
    "smtp"
  ],
  "license": "MIT"
}
